# ==============================================================================
# Boutica Cloud - Variables d'environnement (Configuration officielle)
# ==============================================================================
# Copiez ce fichier vers .env et renseignez les valeurs adaptées à votre environnement.
# Ne commitez JAMAIS de fichiers .env contenant des secrets de production dans git.

# ------------------------------------------------------------------------------
# 1. Base de données relationnelle (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Chaîne de connexion complète PostgreSQL avec sslmode=require.
# Obligatoire. Utilisé par Drizzle ORM et Better Auth.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/boutica?sslmode=require

# ------------------------------------------------------------------------------
# 2. Authentification (Better Auth)
# ------------------------------------------------------------------------------
# Clé secrète de signature cryptographique (au moins 32 caractères aléatoires).
# Obligatoire. Génération recommandée : openssl rand -base64 32
BETTER_AUTH_SECRET=generate_at_least_32_characters_random_secret_here

# URL de base publique du serveur d'authentification.
# Obligatoire. En production sur Render : https://boutica-cloud.onrender.com
# En développement local : http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Serveur & Sécurité CORS
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Liste des origines autorisées (séparées par une virgule).
# Obligatoire en production. Utilisé par Express CORS et Better Auth trustedOrigins.
# Exemples : https://app.boutica.cloud,http://localhost:3000,http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Connexion Google (Google Sign-In / OAuth 2.0)
# ------------------------------------------------------------------------------
# Créer des identifiants OAuth dans la console Google Cloud :
# https://console.cloud.google.com/apis/credentials
# URL de redirection autorisée à configurer dans Google Cloud Console :
#   - Développement : http://localhost:3000/api/auth/callback/google
#   - Production    : https://boutica-cloud.onrender.com/api/auth/callback/google
# Optionnel. Si ces variables sont absentes, Google Sign-In est désactivé sans crash.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 5. Connexion Apple (Sign in with Apple)
# ------------------------------------------------------------------------------
# Configurer dans Apple Developer Portal (Certificates, Identifiers & Profiles) :
# - Identifiers > Services IDs (ex: com.boutica.cloud.auth)
# - Keys > Sign in with Apple Key (fichier .p8)
# URL de redirection autorisée (Return URL) dans Apple Developer :
#   - Production    : https://boutica-cloud.onrender.com/api/auth/callback/apple
# Optionnel. Si ces variables sont absentes, Apple Sign-In est désactivé sans crash.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Optionnel : variables pour génération dynamique du client_secret JWT Apple :
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_KEY_ID=YYYYYYYYYY
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 6. E-mails transactionnels & Réinitialisation de mot de passe (Resend)
# ------------------------------------------------------------------------------
# Clé API obtenue sur https://resend.com/api-keys
# Optionnel. Si absente, les liens de réinitialisation sont consignés dans les logs serveur.
RESEND_API_KEY=
# Adresse d'expédition déclarée et vérifiée dans Resend
EMAIL_FROM=Boutica Cloud <notifications@boutica.cloud>
# URL de la page de réinitialisation dans l'application cliente (Web / Desktop)
# Le token sera transmis sous la forme : ${RESET_PASSWORD_URL}?token=...
RESET_PASSWORD_URL=https://boutica-cloud.onrender.com/reset-password

# ------------------------------------------------------------------------------
# 7. Sécurité & Protection WAF (Arcjet)
# ------------------------------------------------------------------------------
# Obtenez votre clé sur https://launch.arcjet.com
# Laissez vide en développement local pour exécuter en mode simulation/pass-through
ARCJET_KEY=
ARCJET_ENV=development

# ------------------------------------------------------------------------------
# 8. Stockage Médias (Cloudflare R2 / S3-compatible)
# ------------------------------------------------------------------------------
# Bucket compatible S3 pour le stockage des photos de produits et justificatifs
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=boutica-media
R2_PUBLIC_URL=https://media.boutica.cloud

# ------------------------------------------------------------------------------
# 9. Files de tâches asynchrones (Redis & BullMQ)
# ------------------------------------------------------------------------------
# Utilisé pour les exports de rapports, envois asynchrones et tâches d'arrière-plan
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 10. Moteur de Notifications (Novu)
# ------------------------------------------------------------------------------
# Orchestration des notifications (alertes de stock critique, bilans journaliers)
NOVU_API_KEY=
# NOVU_BACKEND_URL=https://api.novu.co

# ------------------------------------------------------------------------------
# 11. Moteur PDF & Puppeteer (Render / Cloud)
# ------------------------------------------------------------------------------
# Par défaut, Puppeteer stocke le binaire Chrome dans .cache/puppeteer à la racine du projet
# grâce au fichier .puppeteerrc.cjs (conservé entre le build et le runtime sur Render).
# Variables optionnelles pour personnalisation :
# PUPPETEER_CACHE_DIR=/opt/render/project/src/.cache/puppeteer
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
