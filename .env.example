# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/boutica?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=generate_at_least_32_characters_random_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Server & CORS
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Phase 2: Arcjet Security ---
# Obtenez votre clé sur https://launch.arcjet.com
# Laissez vide en développement local pour exécuter en mode simulation/pass-through
ARCJET_KEY=
ARCJET_ENV=development

# --- Phase 3: Cloudflare R2 Media Storage ---
# Bucket compatible S3 pour le stockage des images de produits et documents
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=boutica-media
R2_PUBLIC_URL=https://media.boutica.cloud

# --- Phase 5: Redis & BullMQ Queues ---
# Utilisé pour les files de tâches asynchrones (exports de rapports, alertes, notifications)
REDIS_URL=redis://localhost:6379
# Ou configuration granulaire :
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# --- Phase 6: Novu Notification Engine ---
# Orchestration des notifications (alertes stock bas, confirmation de vente)
NOVU_API_KEY=
# NOVU_BACKEND_URL=https://api.novu.co
