{
  "name": "boutica-cloud",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "postinstall": "puppeteer browsers install chrome",
    "dev": "nest start"
  },
  "dependencies": {
    "@arcjet/node": "^1.15.0",
    "@nestjs/cli": "12.0.12",
    "@nestjs/common": "12.4.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "@types/express": "5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "better-auth": "1.7.18",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.4",
    "exceljs": "^4.4.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "puppeteer": "^25.16.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "7.0.2",
    "zod": "4.6.7",
    "@novu/api": "^3.19.1"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.0",
    "@types/jest": "30.0.0",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "drizzle-kit": "0.31.4",
    "eslint": "9.34.0",
    "jest": "30.0.5",
    "supertest": "7.0.0",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testRegex": "src/.*\\.spec\\.ts$",
    "transform": {"^.+\\.(t|j)s$": "ts-jest"},
    "collectCoverageFrom": ["src/**/*.(t|j)s"],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
